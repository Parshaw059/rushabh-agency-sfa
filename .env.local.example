# =======================================================
# RUSHABH AGENCY - MYSQL DATABASE CONFIGURATION
# =======================================================

# OPTION A: Local MySQL (XAMPP / MAMP / Brew MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rushabh_agency_db

# OPTION B: Cloud MySQL (Railway / Aiven / PlanetScale / Cleardb)
# When deploying to Vercel, simply paste your Cloud MySQL Connection URI:
# DATABASE_URL=mysql://root:secret@mysql.railway.internal:3306/rushabh_agency_db
